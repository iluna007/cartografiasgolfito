# Mapbox (obligatorio). Copia este archivo como .env.local y reinicia npm run dev.
VITE_MAPBOX_TOKEN=pk.eyJ...tu-token...

# Opcional: otro estilo de Mapbox
# VITE_MAPBOX_STYLE=mapbox://styles/usuario/estilo

# Opcional: otra hoja de Google Sheets como CMS (por defecto, src/data/fuente.json).
# Usa "local" para leer solo public/capas/*.csv
# VITE_CAPAS_SHEET_ID=
